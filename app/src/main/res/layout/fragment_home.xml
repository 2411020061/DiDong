<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5FAF6"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <!-- Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_bodypoint_leaf"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="StretchCare AI"
                android:textColor="@color/brand_green"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_bookmark"
                android:importantForAccessibility="no" />

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_info_circle"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <!-- Title & Subtitle + Top Banner Graphic -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@id/topGraphic"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Theo dõi tiến bộ"
                    android:textColor="@color/brand_navy"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Mỗi ngày một chút tốt hơn\nvì sức khỏe lâu dài của ba mẹ!"
                    android:textColor="@color/brand_slate"
                    android:textSize="13sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/topGraphic"
                android:layout_width="140dp"
                android:layout_height="110dp"
                android:layout_alignParentEnd="true">

                <ImageView
                    android:layout_width="130dp"
                    android:layout_height="90dp"
                    android:layout_gravity="bottom|end"
                    android:scaleType="centerCrop"
                    android:src="@drawable/home_neck_stretch"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:background="@drawable/bg_badge_green_light"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="Tiến bộ mỗi ngày\nsống vui hơn! 💚"
                    android:textColor="@color/brand_green_dark"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </RelativeLayout>

        <!-- 4 Metric Cards Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <!-- Metric 1: Biên độ vận động -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_white"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="12dp">

                <vn.edu.mku.ecoscan.ui.DonutProgressView
                    android:layout_width="54dp"
                    android:layout_height="54dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Biên độ vận động"
                    android:textColor="@color/brand_navy"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="↑ +8% so với hôm qua"
                    android:textColor="@color/brand_green_dark"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Metric 2: Tư thế đúng -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_white"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👤  92%"
                    android:textColor="@color/brand_navy"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Tư thế đúng"
                    android:textColor="@color/brand_navy"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="↑ +5% so với hôm qua"
                    android:textColor="@color/brand_green_dark"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <!-- Metric 3: Số ngày liên tục -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_white"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📅  12"
                    android:textColor="@color/brand_navy"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Số ngày liên tục"
                    android:textColor="@color/brand_navy"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="↑ +2 ngày so với tuần trước"
                    android:textColor="@color/brand_green_dark"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Metric 4: Thời gian giữ -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_white"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏱  15 phút"
                    android:textColor="@color/brand_navy"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Thời gian giữ"
                    android:textColor="@color/brand_navy"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="↑ +3 phút so với hôm qua"
                    android:textColor="@color/brand_green_dark"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 7-Day Progress Chart Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card_white"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Biểu đồ tiến bộ 7 ngày qua"
                android:textColor="@color/brand_navy"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Filter Pills -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_active_filter"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:text="Biên độ vận động"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_pill_inactive_filter"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:text="Tư thế đúng"
                    android:textColor="@color/brand_slate"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_pill_inactive_filter"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:text="Thời gian giữ"
                    android:textColor="@color/brand_slate"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Line Chart -->
            <vn.edu.mku.ecoscan.ui.HomeProgressChartView
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="10dp" />

            <!-- Banner Message Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_banner_mint"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📊 "
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bạn đang tiến bộ đều đặn!"
                        android:textColor="@color/brand_green_dark"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Hôm nay biên độ vận động cao hơn 26% so với 7 ngày trước."
                        android:textColor="@color/brand_slate"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Posture Comparison & Today's Assessment Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <!-- Left Card: So sánh tư thế -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="So sánh tư thế"
                    android:textColor="@color/brand_navy"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Hôm qua -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hôm qua"
                            android:textColor="@color/brand_slate"
                            android:textSize="10sp" />

                        <ImageView
                            android:layout_width="60dp"
                            android:layout_height="75dp"
                            android:layout_marginTop="4dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/home_neck_stretch"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_badge_red_light"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp"
                            android:text="Còng nhẹ"
                            android:textColor="#D34B3C"
                            android:textSize="9sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" › "
                        android:textColor="@color/brand_blue"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <!-- Hôm nay -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hôm nay"
                            android:textColor="@color/brand_slate"
                            android:textSize="10sp" />

                        <ImageView
                            android:layout_width="60dp"
                            android:layout_height="75dp"
                            android:layout_marginTop="4dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/exercise_shoulder"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_badge_green_light"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp"
                            android:text="Thẳng hơn"
                            android:textColor="@color/brand_green_dark"
                            android:textSize="9sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Right Card: Đánh giá hôm nay -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="12dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✨ Đánh giá hôm nay"
                        android:textColor="@color/brand_navy"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="Xem chi tiết ›"
                        android:textColor="@color/brand_blue"
                        android:textSize="10sp" />
                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="😊 "
                        android:textSize="24sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="Biên độ vai phải tăng 8% so với hôm qua!"
                        android:textColor="@color/brand_green_dark"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_quote_mint"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🍃 "
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="&quot;Tư thế ngồi thẳng hơn, biên độ tay cải thiện rõ rệt. Hãy tiếp tục duy trì nhé!&quot;"
                        android:textColor="@color/brand_blue"
                        android:textSize="10sp"
                        android:textStyle="italic" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Exercise History Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card_white"
            android:orientation="vertical"
            android:padding="14dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lịch sử luyện tập"
                    android:textColor="@color/brand_navy"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="Xem tất cả ›"
                    android:textColor="@color/brand_blue"
                    android:textSize="11sp" />
            </RelativeLayout>

            <!-- Day Selector Pills -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_inactive_filter"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:text="Thứ 6\n12/04 ✓"
                        android:textColor="@color/brand_slate"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_pill_inactive_filter"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:text="Thứ 7\n13/04 ✓"
                        android:textColor="@color/brand_slate"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_pill_inactive_filter"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:text="CN\n14/04 ✓"
                        android:textColor="@color/brand_slate"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_pill_inactive_filter"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:text="Thứ 2\n15/04 ✓"
                        android:textColor="@color/brand_slate"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_pill_inactive_filter"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:text="Thứ 3\n16/04 ✓"
                        android:textColor="@color/brand_slate"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_pill_inactive_filter"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:text="Thứ 4\n17/04 ✓"
                        android:textColor="@color/brand_slate"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_pill_mint_stroke"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:text="Hôm nay\n18/04 ✓"
                        android:textColor="@color/brand_green_dark"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Recent Sessions List -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <!-- Session 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_banner_mint"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/exercise_shoulder"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Giãn vai"
                            android:textColor="@color/brand_navy"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="⏱ 5 phút   |   📊 Tư thế đúng 94%"
                            android:textColor="@color/brand_slate"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_pill_inactive_filter"
                        android:gravity="center"
                        android:text="›"
                        android:textColor="@color/brand_green"
                        android:textSize="16sp" />
                </LinearLayout>

                <!-- Session 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_banner_mint"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/exercise_wrist_up_assisted"
                        android:importantForAccessibility="no" />

                    <LinearLayout
