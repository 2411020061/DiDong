<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/bg_home_feature" android:gravity="center_vertical"
    android:minHeight="104dp" android:orientation="horizontal" android:padding="10dp">
    <ImageView android:id="@+id/exerciseThumbnail" android:layout_width="78dp"
        android:layout_height="78dp" android:background="@drawable/bg_home_thumbnail"
        android:clipToOutline="true" android:scaleType="centerCrop"
        android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginStart="13dp" android:layout_weight="1"
        android:orientation="vertical">
        <TextView android:id="@+id/exerciseName" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="@color/brand_navy"
            android:textSize="17sp" android:textStyle="bold" />
        <TextView android:id="@+id/exerciseSummary" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:textColor="@color/brand_slate" android:textSize="13sp"
            android:maxLines="2" />
    </LinearLayout>
    <ImageView android:id="@+id/exerciseCameraIcon" android:layout_width="42dp"
        android:layout_height="42dp" android:layout_marginEnd="6dp"
        android:background="@drawable/bg_exercise_pill"
        android:padding="9dp" android:src="@drawable/ic_camera_icon"
        android:contentDescription="Mở camera bài tập" />
</LinearLayout>