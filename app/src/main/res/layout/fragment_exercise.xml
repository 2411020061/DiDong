<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#FAFCFB" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="18dp" android:paddingEnd="18dp"
        android:paddingTop="18dp" android:paddingBottom="20dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="36dp" android:layout_height="36dp"
                android:src="@drawable/ic_bodypoint_leaf"
                android:contentDescription="Biểu tượng BodyPoint" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="6dp"
                android:text="BodyPoint" android:textColor="@color/brand_green"
                android:textSize="23sp" android:textStyle="bold" />
            <TextView android:id="@+id/exerciseBadge" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:background="@drawable/bg_exercise_pill"
                android:paddingHorizontal="10dp" android:paddingVertical="7dp"
                android:text="15 giây" android:textColor="@color/brand_green_dark"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="17dp" android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView android:id="@+id/exerciseTitle" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Giãn cổ" android:textColor="@color/brand_navy"
                android:textSize="29sp" android:textStyle="bold" />
            <TextView android:id="@+id/exerciseExit" android:layout_width="wrap_content"
                android:layout_height="48dp" android:gravity="center"
                android:paddingHorizontal="13dp" android:background="@drawable/bg_exercise_pill"
                android:text="×  Thoát" android:textColor="@color/brand_green_dark"
                android:textSize="14sp" android:visibility="gone" />
        </LinearLayout>
        <TextView android:id="@+id/exerciseSubtitle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="2dp"
            android:layout_marginBottom="14dp" android:textColor="@color/brand_slate"
            android:textSize="14sp" android:visibility="gone" />
        <FrameLayout android:id="@+id/exerciseCameraFrame"
            android:layout_width="match_parent" android:layout_height="360dp"
            android:layout_marginTop="12dp"
            android:background="#000000"
            android:clipToOutline="true" android:elevation="3dp">
            <ImageView android:id="@+id/exerciseGuideImage"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="centerCrop" android:src="@drawable/neck_stretch_guide"
                android:importantForAccessibility="no" />
            <ImageView android:id="@+id/exerciseHostPreview"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="centerCrop" android:background="#000000"
                android:contentDescription="Webcam máy tính" android:visibility="gone" />
            <androidx.camera.view.PreviewView android:id="@+id/exercisePreview"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:background="#000000"
                android:visibility="gone" />
            <vn.edu.mku.ecoscan.ui.scan.PoseOverlayView android:id="@+id/exerciseOverlay"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:visibility="gone" />
            <vn.edu.mku.ecoscan.ui.scan.ExerciseTimerView android:id="@+id/exerciseTimer"
                android:layout_width="92dp" android:layout_height="92dp"
                android:layout_gravity="top|end" android:layout_marginTop="104dp"
                android:layout_marginEnd="8dp" android:visibility="gone" />
            <TextView android:id="@+id/exerciseCameraStatus" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_gravity="top|start"
                android:layout_margin="10dp" android:background="@drawable/bg_exercise_pill"
                android:paddingHorizontal="10dp" android:paddingVertical="8dp"
                android:text="Ảnh minh họa" android:textColor="@color/brand_green_dark"
                android:textSize="12sp" android:visibility="gone" />
            <TextView android:id="@+id/exerciseRecording" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_gravity="top|end"
                android:layout_margin="10dp" android:background="@drawable/bg_exercise_pill"
                android:paddingHorizontal="10dp" android:paddingVertical="8dp"
                android:text="● Chưa ghi nhận" android:textColor="@color/brand_green_dark"
                android:textSize="12sp" android:visibility="gone" />
            <LinearLayout android:id="@+id/exerciseCameraActions"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="top|end" android:layout_marginTop="52dp"
                android:layout_marginEnd="10dp" android:orientation="horizontal"
                android:visibility="gone">
                <TextView android:id="@+id/exerciseRotate" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:background="@drawable/bg_exercise_pill"
                    android:paddingHorizontal="11dp" android:paddingVertical="7dp"
                    android:text="⟳ Xoay hình" android:textColor="@color/brand_green_dark"
                    android:textSize="12sp" android:textStyle="bold"
                    android:elevation="4dp" />
                <TextView android:id="@+id/exerciseFlipCamera" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginStart="6dp"
                    android:background="@drawable/bg_exercise_pill"
                    android:paddingHorizontal="11dp" android:paddingVertical="7dp"
                    android:text="⇄ Đổi camera" android:textColor="@color/brand_green_dark"
                    android:textSize="12sp" android:textStyle="bold"
                    android:elevation="4dp" />
            </LinearLayout>
            <TextView android:id="@+id/exerciseStart" android:layout_width="wrap_content"
                android:layout_height="54dp" android:layout_gravity="center"
                android:background="@drawable/bg_exercise_button"
                android:gravity="center" android:paddingHorizontal="21dp"
                android:text="Mở camera" android:textColor="#FFFFFF"
                android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/exerciseCoach" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_gravity="bottom"
                android:layout_margin="10dp" android:background="@drawable/bg_exercise_pill"
                android:gravity="center" android:minHeight="40dp" android:padding="8dp"
                android:text="Đặt người vào khung hình"
                android:textColor="@color/brand_green_dark" android:textSize="13sp"
                android:visibility="gone" />
        </FrameLayout>
        <LinearLayout android:id="@+id/exerciseCard" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="15dp" android:background="@drawable/bg_exercise_card"
            android:gravity="center_vertical" android:orientation="horizontal"
            android:padding="12dp" android:visibility="gone">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginStart="16dp" android:layout_weight="1"
                android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Tư thế" android:textColor="@color/brand_slate"
                    android:textSize="13sp" />
                <TextView android:id="@+id/exerciseLandmarks" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="2dp"
                    android:text="Chưa rõ" android:textColor="@color/brand_navy"
                    android:textSize="20sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:orientation="horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Đúng " android:textColor="@color/brand_slate"
                        android:textSize="13sp" />
                    <TextView android:id="@+id/exercisePercent" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0%"
                        android:textColor="@color/brand_green_dark" android:textSize="13sp"
                        android:textStyle="bold" />
                    <TextView android:id="@+id/exerciseProgress" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginStart="8dp"
                        android:text="0 / 15 giây" android:textColor="@color/brand_slate"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>